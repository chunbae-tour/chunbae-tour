# 로컬 개발 환경 변수 예시
# 사용 전 이 파일을 .env로 복사하세요.
# macOS/Linux: cp .env.example .env
# Windows PowerShell: Copy-Item .env.example .env

DB_HOST=localhost
DB_PORT=3307
DB_NAME=chunbae_tour
DB_USERNAME=chunbae
DB_PASSWORD=1234

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# JWT (로컬 전용 dummy 값. PROD 환경에서 절대 사용하지 마세요.)
# JWT_SECRET은 HS256 서명용. base64 등 인코딩 없이 raw 문자열, 32바이트 이상 권장.
# TTL은 ISO-8601 Duration 형식 (PT30M = 30분, P7D = 7일).
JWT_SECRET=local-dev-only-secret-replace-me-min-32-bytes-xxxx
JWT_ACCESS_TOKEN_TTL=PT30M
JWT_REFRESH_TOKEN_TTL=P7D

# CORS 허용 origin (콤마 구분). 로컬 프론트엔드 개발 서버 기본값.
# Cookie credential 흐름과 호환되려면 와일드카드(*) 사용 불가 — 명시적 origin만 허용.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Refresh Cookie SameSite 정책 (KAN-125 S5). Lax/Strict/None 중 선택.
# - 로컬 default Lax: localhost cross-port도 same-site로 취급되어 호환.
# - prod에서 프론트/백엔드 도메인이 서로 다른 site면 None + secure=true 필수 (브라우저 요구사항).
# - 의사결정 가이드: docs/operations/samesite-policy.md
COOKIE_SAMESITE=Lax

# Rate Limit 전역 토글 (기본 true). 로컬에서 같은 endpoint를 반복 호출하는 시연/디버깅 시 false로 비활성화.
# 운영(application-prod.yml)은 항상 true 강제.
RATELIMIT_ENABLED=true

# Google Cloud Translation API Key
GOOGLE_TRANSLATION_API_KEY=your-google-translation-api-key-here

# Kakao Map API Key (REST API 키)
KAKAO_MAP_API_KEY=your-kakao-rest-api-key-here

# PortOne V2 결제 연동 키 (포트원 콘솔 > 연동 정보에서 발급)
PORTONE_SECRET=your-portone-v2-api-secret
PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PORTONE_CHANNEL_CARD=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PORTONE_CHANNEL_KAKAO_PAY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PORTONE_CHANNEL_TOSS_PAY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PORTONE_CHANNEL_FOREIGN_CARD=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PORTONE_WEBHOOK_SECRET=whsec_your-portone-webhook-secret

# 공공데이터포털 service key — 전통시장(KAN-220)·축제(KAN-97) 수집용.
# prod 프로파일 부팅 시 SecretValidator가 필수 검증(미설정 시 SECRET_VALIDATION FAILED).
PUBLIC_DATA_MARKET_KEY=your-public-data-portal-service-key
TOUR_API_SERVICE_KEY=your-tour-api-service-key

# 관광지 KorService2(국문 관광정보) service key — 관광지 수집(KAN-221)용.
# 축제·전통시장과 다른 data.go.kr 계정/활용신청을 쓸 수 있어 전용 env로 분리한다.
# KorService2 활용신청한 계정의 디코딩(raw) 키를 주입할 것(인코딩 키 사용 시 이중 인코딩 오류).
TOUR_API_KOR_SERVICE_KEY=your-tour-api-kor-service-key

# 정산 계좌번호 AES-128-GCM 암호화 키 (KAN-244). 반드시 '정확히 16바이트'(AES-128 key size).
# prod 미설정/길이 오류 시 부팅 실패 — 기본값 없음. 운영은 안전한 16바이트 키로 교체.
ACCOUNT_ENCRYPTION_KEY=localdevkey12345
