+                .orElseThrow(() -> new BusinessException(ErrorCode.WALLET_NOT_FOUND));
+
+        long reclaimed = wallet.debitUpTo(amount);
+        yeopjeonHistoryRepository.save(
+                YeopjeonHistory.ofExternalCancelReclaim(
