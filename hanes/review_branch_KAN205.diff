+        verify(paymentGatewayClient).cancelPayment(eq("order-uid-1"), eq(10_000L), eq("user request"), eq("refund-1"));
+        verify(refundService).completeSchedulerRetry(1L, "order-uid-1", 10_000L);
+    }
+
