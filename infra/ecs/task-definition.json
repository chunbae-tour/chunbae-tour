{
  "family": "chunbae-tour",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::310133718863:role/chunbae-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::310133718863:role/chunbae-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "chunbae-tour",
      "image": "310133718863.dkr.ecr.ap-northeast-2.amazonaws.com/chunbae-tour:<IMAGE_TAG>",
      "essential": true,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" },
        { "containerPort": 9090, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "prod" }
      ],
      "secrets": [
        { "name": "DB_HOST", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:DB_HOST::" },
        { "name": "DB_NAME", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:DB_NAME::" },
        { "name": "DB_USERNAME", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:DB_USERNAME::" },
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:DB_PASSWORD::" },
        { "name": "REDIS_HOST", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:REDIS_HOST::" },
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:JWT_SECRET::" },
        { "name": "CORS_ALLOWED_ORIGINS", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:CORS_ALLOWED_ORIGINS::" },
        { "name": "ACCOUNT_ENCRYPTION_KEY", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:ACCOUNT_ENCRYPTION_KEY::" },
        { "name": "PORTONE_SECRET", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:PORTONE_SECRET::" },
        { "name": "PORTONE_WEBHOOK_SECRET", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:PORTONE_WEBHOOK_SECRET::" },
        { "name": "PORTONE_STORE_ID", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:PORTONE_STORE_ID::" },
        { "name": "PORTONE_CHANNEL_CARD", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:PORTONE_CHANNEL_CARD::" },
        { "name": "PORTONE_CHANNEL_KAKAO_PAY", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:PORTONE_CHANNEL_KAKAO_PAY::" },
        { "name": "PORTONE_CHANNEL_TOSS_PAY", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:PORTONE_CHANNEL_TOSS_PAY::" },
        { "name": "PORTONE_CHANNEL_FOREIGN_CARD", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:PORTONE_CHANNEL_FOREIGN_CARD::" },
        { "name": "GOOGLE_TRANSLATION_API_KEY", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:GOOGLE_TRANSLATION_API_KEY::" },
        { "name": "KAKAO_MAP_API_KEY", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:KAKAO_MAP_API_KEY::" },
        { "name": "KAKAO_LOGIN_REST_API_KEY", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:KAKAO_LOGIN_REST_API_KEY::" },
        { "name": "KAKAO_LOGIN_CLIENT_SECRET", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:KAKAO_LOGIN_CLIENT_SECRET::" },
        { "name": "NAVER_CLIENT_ID", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:NAVER_CLIENT_ID::" },
        { "name": "NAVER_CLIENT_SECRET", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:NAVER_CLIENT_SECRET::" },
        { "name": "TOUR_API_SERVICE_KEY", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:TOUR_API_SERVICE_KEY::" },
        { "name": "TOUR_API_KOR_SERVICE_KEY", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:TOUR_API_KOR_SERVICE_KEY::" },
        { "name": "PUBLIC_DATA_MARKET_KEY", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:310133718863:secret:chunbae-tour/prod-DFWHK4:PUBLIC_DATA_MARKET_KEY::" }
      ],
      "stopTimeout": 35,
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -q -O - http://localhost:9090/actuator/health || exit 1"],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 300
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/chunbae-tour",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "adot-collector",
      "image": "public.ecr.aws/aws-observability/aws-otel-collector:v0.48.0",
      "essential": false,
      "cpu": 128,
      "memoryReservation": 128,
      "memory": 256,
      "dependsOn": [
        { "containerName": "chunbae-tour", "condition": "HEALTHY" }
      ],
      "secrets": [
        { "name": "AOT_CONFIG_CONTENT", "valueFrom": "arn:aws:ssm:ap-northeast-2:310133718863:parameter/chunbae-tour/prod/adot-config" }
      ],
      "environment": [
        { "name": "AWS_REGION", "value": "ap-northeast-2" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -q -O - http://localhost:13133/ || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/chunbae-tour",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "adot",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
