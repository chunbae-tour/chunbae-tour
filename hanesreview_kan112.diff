+    private Shop createActiveShop() {
+        Shop shop = Shop.builder()
+                .userId(MERCHANT_USER_ID)
+                .applicationId(1L)
+                .shopName("광화문 떡볶이")
+                .category("FOOD")
+                .address("서울 종로구")
+                .phone("02-1234-5678")
+                .description("전통 떡볶이 전문점")
+                .build();
+        ReflectionTestUtils.setField(shop, "id", SHOP_ID);
+        return shop;
+    }
